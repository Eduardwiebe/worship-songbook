{
  "identifier": "mobile-default",
  "description": "Minimal iOS/Android capabilities for Worship Songbook (same API/auth surface as desktop)",
  "windows": ["main"],
  "platforms": ["iOS", "android"],
  "permissions": [
    "core:default",
    "allow-secure-set",
    "allow-secure-get",
    "allow-secure-delete",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://songbook.lyruma.app" },
        { "url": "https://songbook.lyruma.app/**" }
      ]
    },
    {
      "identifier": "opener:default",
      "allow": [
        { "url": "https://lyruma.studio" },
        { "url": "https://lyruma.studio/**" },
        { "url": "https://lyruma.app" },
        { "url": "https://lyruma.app/**" },
        { "url": "https://*.lyruma.studio" },
        { "url": "https://*.lyruma.studio/**" },
        { "url": "https://songbook.lyruma.app" },
        { "url": "https://songbook.lyruma.app/**" },
        { "url": "https://www.paypal.com" },
        { "url": "https://www.paypal.com/**" },
        { "url": "https://paypal.com" },
        { "url": "https://paypal.com/**" },
        { "url": "https://github.com" },
        { "url": "https://github.com/**" },
        { "url": "https://www.instagram.com" },
        { "url": "https://www.instagram.com/**" },
        { "url": "mailto:support@lyruma.studio" },
        { "url": "mailto:info@lyruma.studio" }
      ]
    }
  ]
}
