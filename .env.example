# Optional override for the frontend API base.
# Leave empty for same-origin web deployments.
# For native / local preview against production:
# VITE_API_BASE=https://songbook.lyruma.app
VITE_API_BASE=

# Backend listen address is configured in systemd / server.mjs (127.0.0.1:8791).

# Multimodal page recognition (optional). Without a key, Audiveris/RapidOCR stays the fallback.
# SONGBOOK_VISION_API_KEY=
# SONGBOOK_VISION_MODEL=gpt-4.1

# Optional YouTube Data API key for concrete video IDs on rehearsal links.
# Without it, Songbook stores a YouTube search URL (title/artist, preferring original-language worship titles).
# YOUTUBE_API_KEY=
